}

# ── SIGTERM → KeyboardInterrupt ───────────────────────────────────────────────
signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(KeyboardInterrupt()))


# ── chirp generators ──────────────────────────────────────────────────────────

def generate_chirp(f0, f1, duration, fs):
    """Real-valued reference chirp (for any legacy callers)."""
    t   = np.linspace(0, duration, int(fs * duration), endpoint=False)
    k   = (f1 - f0) / duration
    phi = 2 * np.pi * (f0 * t + 0.5 * k * t ** 2)
    return np.sin(phi).astype(np.float32)


def generate_complex_chirp(f0, f1, duration, fs):
    """
    Analytic chirp for dechirping.

    r(t) · conj(generate_complex_chirp(f0, f1, ...)) collapses a chirp
    that sweeps f0→f1 into a near-DC tone.  Unmatched chirps or noise
    remain spectrally flat, allowing a narrow FFT search to reject them.
    """
    t   = np.linspace(0, duration, int(fs * duration), endpoint=False)
    k   = (f1 - f0) / duration
    phi = 2 * np.pi * (f0 * t + 0.5 * k * t ** 2)
    return np.exp(1j * phi).astype(np.complex64)


# ── helpers ───────────────────────────────────────────────────────────────────

def bits_to_bytes(bits):
    out = []
    for i in range(0, len(bits), 8):
        b = bits[i: i + 8]
        if len(b) < 8:
            break
        val = 0
        for bit in b:
            val = (val << 1) | bit
        out.append(val)
    return bytes(out)


def check_crc(raw_bytes, chunk_size):
    if len(raw_bytes) < 1 + chunk_size + CRC_BYTES:
        return False, 0, b""
    seq      = raw_bytes[0]
    data     = raw_bytes[1: 1 + chunk_size]
    received = raw_bytes[1 + chunk_size: 1 + chunk_size + CRC_BYTES]
    expected = (zlib.crc32(bytes([seq]) + data) & 0xFFFFFFFF).to_bytes(4, "big")
    return received == expected, seq, data


# ── AGC ───────────────────────────────────────────────────────────────────────

class AGC:
    """max_gain=200 covers input levels down to ≈ −43 dBFS at target −3 dBFS."""

    def __init__(self, target_dbfs=-3.0, release_coef=0.05,
                 attack_coef=0.5, max_gain=200.0):
        self.target_rms = 10 ** (target_dbfs / 20.0)
        self.release    = release_coef
        self.attack     = attack_coef
        self.max_gain   = max_gain
        self.gain       = 1.0

    def process(self, chunk):
        rms = float(np.sqrt(np.mean(chunk.astype(np.float64) ** 2)))
        if rms < 1e-9:
            return chunk.astype(np.float32) * self.gain, self.gain, -120.0
        desired = self.target_rms / rms
        alpha   = self.attack if desired < self.gain else self.release
        self.gain += alpha * (desired - self.gain)
        self.gain  = float(np.clip(self.gain, 1.0, self.max_gain))
        out        = np.clip(chunk * self.gain, -1.0, 1.0).astype(np.float32)
        rms_out    = float(np.sqrt(np.mean(out.astype(np.float64) ** 2)))
        dbfs       = 20.0 * np.log10(rms_out) if rms_out > 1e-9 else -120.0
        return out, self.gain, dbfs


# ── Dechirp scorer — single fixed search window, no dc_centre ─────────────────

class DechirpScorer:
    """
    Binary CSS symbol decision: dechirp both chirp directions, compare DC peaks.

    The scorer has NO internal adaptive state.  It always searches ±search_bins
    around bin 0.  Timing is corrected exclusively via RotationPLL.best_offset
    (time-domain); there is no frequency-domain dc_centre to fight it.

    Why no dc_centre
    ─────────────────
    Any persistent frequency offset that would shift the DC tone from bin 0
    is identical in effect to a constant timing offset τ = f_offset·sps·fs/(BW).
    post_lock_update absorbs it by adjusting best_offset until the tone returns
    to bin 0.  A separate dc_centre tracker is redundant and harmful: when
    best_offset changes, the tone shifts back toward 0, but dc_centre lags
    (exponential smoothing), so it searches the wrong neighbourhood for several
    symbols and returns corrupted TED values to the very loop that moved it.

    search_bins
    ───────────
    Must cover the worst-case initial DC-bin offset after coarse rotation lock:

        max_residual_samp  ≈  sps / (2·n_rotations)
        max_bin            =  BW·max_residual·nfft / (sps·fs)
                           =  BW·nfft / (2·n_rotations·fs)

    With a 12-bin safety margin this is auto-computed by the caller and passed in.
    After a few post_lock_update calls (kp=0.50 → 6 symbols) the tone returns
    to bin 0, so search_bins can be conservatively wide without harming SNR at
    high input levels.

    Timing-error discriminant (TED)
    ────────────────────────────────
    ted_bin is the SIGNED FFT bin of the winning dechirp's dominant peak.
    Negative bin → symbol late (arrives after window start).
    Positive bin → symbol early.
    RotationPLL.post_lock_update converts this to a sample-domain correction.
    """

    def __init__(self, up_ref_c, dn_ref_c, search_bins):
        self.up_c  = up_ref_c.astype(np.complex128)
        self.dn_c  = dn_ref_c.astype(np.complex128)
        sps        = len(up_ref_c)
        self.sps   = sps
        self.nfft  = 1 << (sps - 1).bit_length()   # next power-of-two ≥ sps
        self.hann  = np.hanning(sps)
        self.sb    = int(search_bins)

        # Precompute search index array (constant, centred on bin 0).
        # Covers bins [−sb, +sb] with FFT wrap-around for negative frequencies.
        N          = self.nfft
        self._idxs = np.arange(-self.sb, self.sb + 1) % N   # shape (2*sb+1,)

    # ── internal ──────────────────────────────────────────────────────────────

    def _score_one(self, wc, ref_c):
        """
        Dechirp `wc` against `ref_c`, apply Hann window, FFT, return
        the peak magnitude and its signed FFT bin within ±sb of bin 0.
        """
        N    = self.nfft
        spec = np.abs(np.fft.fft(wc * np.conj(ref_c) * self.hann, N))
        band = spec[self._idxs]
        li         = int(np.argmax(band))
        pk_bin     = int(self._idxs[li])
        pk_val     = float(band[li])
        signed_bin = pk_bin if pk_bin <= N // 2 else pk_bin - N
        return pk_val, signed_bin

    # ── public ────────────────────────────────────────────────────────────────

    def score(self, window):
        """
        Score a real-valued symbol window of length sps.

        Returns
        -------
        bit     : int   — 0 (down-chirp) or 1 (up-chirp)
        norm    : float — (up_pk − dn_pk) / (up_pk + dn_pk)  ∈ [−1, +1]
        ted_bin : int   — signed DC bin of winning dechirp (timing error)
        up_val  : float — up-dechirp peak magnitude (diagnostics)
        dn_val  : float — dn-dechirp peak magnitude (diagnostics)
        """
        wc              = window.astype(np.complex128)
        up_val, up_bin  = self._score_one(wc, self.up_c)
        dn_val, dn_bin  = self._score_one(wc, self.dn_c)
        tot             = up_val + dn_val + 1e-15
        norm            = (up_val - dn_val) / tot
        bit             = int(norm > 0)
        ted_bin         = up_bin if bit == 1 else dn_bin
        return bit, float(norm), ted_bin, up_val, dn_val


# ── Rotation PLL ──────────────────────────────────────────────────────────────

class RotationPLL:
    """
    Two-phase symbol timing recovery — single time-domain integrator.

    PRE-LOCK (rotation scan)
    ─────────────────────────
    Each symbol: score n_rotations equally-spaced windows from the 2×sps
    ring.  Vote for the offset whose |norm| is highest.  Losers decay by
    0.75 per symbol.  Lock declared when the same offset wins lock_patience
    consecutive symbols.

    POST-LOCK (offset tracking)
    ────────────────────────────
    hop is ALWAYS sps.  Only best_offset is adjusted.

    Ring layout after each sps-sample read:
        ring[0   : sps] = previous read
        ring[sps : 2*sps] = current read

    Symbol window: ring[best_offset : best_offset + sps].

    post_lock_update MUST be called on EVERY post-lock symbol (preamble and
    data alike) to prevent timing error from accumulating uncontrolled during
    the preamble phase (8 symbols = 8 × clock_offset worth of drift with
    kp=0.04 and no correction — that was root cause 1 of the CRC failures).

    Convergence (kp = 0.50, τ₀ = worst-case 413 samples):
        sym 1:  τ → 207 samples  (50 % reduction per symbol)
        sym 4:  τ →  26 samples
        sym 6:  τ →   6 samples  (< 1 search-window bin)
    """

    def __init__(self, sps, nfft, f_min, f_max, fs,
                 n_rotations=8, lock_patience=5,
                 kp=0.50, max_hop_frac=0.125):
        self.sps           = sps
        self.nfft          = nfft
        self.n_rotations   = n_rotations
        self.lock_patience = lock_patience
        self.kp            = float(kp)
        self.max_hop_adj   = max(int(sps * max_hop_frac), 32)

        bw           = float(f_max - f_min)
        # b = −BW·τ·nfft / (sps·fs)  →  τ = −b · sps·fs / (BW·nfft)
        self._b2s    = (sps * fs) / (bw * nfft) if bw > 0 else 1.0

        self._reset_state()

    def _reset_state(self):
        self.locked        = False
        self.best_offset   = 0
        self._votes        = {}
        self._stable_count = 0
        self._last_best    = -1

    def reset(self):
        self._reset_state()

    def rotation_offsets(self):
        """n_rotations equally-spaced candidate start positions in 2×sps ring."""
        step = self.sps // self.n_rotations
        return [i * step for i in range(self.n_rotations)]

    def pre_lock_vote(self, best_rot_idx, score_weight):
        """
        Accumulate vote; decay losers; declare lock when stable.
        Returns True when lock is declared.
        """
        v = self._votes
        v[best_rot_idx] = v.get(best_rot_idx, 0.0) + score_weight
        for k in list(v.keys()):
            if k != best_rot_idx:
                v[k] *= 0.75
                if v[k] < 0.05:
                    del v[k]

        winner = max(v, key=v.get)
        if winner == self._last_best:
            self._stable_count += 1
        else:
            self._stable_count = 1
            self._last_best    = winner

        if self._stable_count >= self.lock_patience:
            step             = self.sps // self.n_rotations
            self.locked      = True
            self.best_offset = winner * step
        return self.locked

    def post_lock_update(self, ted_bin):
        """
        Shift best_offset to reduce timing error.  Called every symbol
        after PLL lock — preamble AND data.  Hop never changes.

        ted_bin < 0  →  symbol late  →  adj > 0  →  best_offset ↑  ✓
        ted_bin > 0  →  symbol early →  adj < 0  →  best_offset ↓  ✓
        """
        if self.kp == 0.0:
            return
        # timing_err_samp = −τ_samp  (negative when symbol is late)
        timing_err = float(ted_bin) * self._b2s
        adj        = float(np.clip(
            -self.kp * timing_err,
            -self.max_hop_adj, self.max_hop_adj,
        ))
        # Keep within [0, sps]: window must stay inside the ring.
        self.best_offset = int(round(
            np.clip(self.best_offset + adj, 0, self.sps)
        ))

    @property
    def hop_current(self):
        """Always sps.  Timing correction is via best_offset only."""
        return self.sps


# ── Soft preamble detector (unchanged from v2) ───────────────────────────────

class SoftPreambleDetector:
    """Barker-13 sliding-window detector on normalised chirp scores."""

    def __init__(self, preamble, threshold=0.85):
        self.preamble  = preamble
        self.n         = len(preamble)
        self.threshold = threshold
        self.expected  = np.array([1.0 if b else -1.0 for b in preamble])
        self.scores    = []

    def reset(self):
        self.scores = []

    def push(self, norm_score):
        self.scores.append(float(norm_score))
        if len(self.scores) < self.n:
            return False, 0.0
        window = np.array(self.scores[-self.n:])
        agrees = (window * self.expected) > 0
        frac   = float(np.mean(agrees))
        return frac >= self.threshold, frac


# ── Main decode loop ──────────────────────────────────────────────────────────

def decode(cfg, stop_event=None):
    import sounddevice as sd

    info_path      = Path(cfg.get("info",               "css_info.json"))
    result_path    = Path(cfg.get("result_out",          "css_decode_result.json"))
    timeout_sec    = float(cfg.get("timeout_sec",        600))
    silence_thr    = float(cfg.get("silence_threshold",  0.002))
    sync_threshold = float(cfg.get("sync_threshold",     0.85))
    agc_target     = float(cfg.get("agc_target_dbfs",   -3.0))
    agc_release    = float(cfg.get("agc_release_coef",   0.05))
    pll_kp         = float(cfg.get("pll_kp",             0.50))
    n_rotations    = int(  cfg.get("n_rotations",         8))
    lock_patience  = int(  cfg.get("lock_patience",       5))
    device         = cfg.get("device")
    if device is not None:
        try:    device = int(device)
        except: device = None   # noqa: E722

    result = {
        "status": "error", "failure_reason": None,
        "frames_decoded": 0, "frames_errored": 0,
        "decoded_text": "", "diagnostics": {}, "frames": [],
    }

    if not info_path.exists():
        print(f"ERROR: info file not found: {info_path}", flush=True)
        result["failure_reason"] = "no_info_file"
        result_path.write_text(json.dumps(result, indent=2))
        print(json.dumps(result), flush=True)
        return result

    conf       = json.loads(info_path.read_text())
    fs         = int(  cfg.get("fs",         conf["fs"]))
    dur        = float(cfg.get("symbol_dur", conf["symbol_dur"]))
    f_min      = float(cfg.get("f_min",      conf["f_min"]))
    f_max      = float(cfg.get("f_max",      conf["f_max"]))
    preamble   = list( cfg.get("preamble",   conf.get("preamble", BARKER_13)))
    chunk_size = int(  cfg.get("chunk_size", conf["chunk_size"]))
    crc_bytes  = int(  conf.get("crc_bytes", CRC_BYTES))
    bw         = float(f_max - f_min)

    sps            = int(fs * dur)
    buf_size       = sps * 2          # ring holds 2 consecutive reads
    bits_per_frame = (1 + chunk_size + crc_bytes) * 8
    resync_after   = 3

    # ── auto-compute search_bins ──────────────────────────────────────────────
    # Must cover worst-case DC-bin offset after coarse rotation lock.
    # Worst-case residual timing error = sps / (2 * n_rotations) samples.
    # Corresponding DC bin = BW * residual * nfft / (sps * fs).
    nfft_probe   = 1 << (sps - 1).bit_length()
    rot_residual = sps // (2 * n_rotations)          # samples
    max_dc_bin   = int(np.ceil(bw * rot_residual * nfft_probe / (sps * fs)))
    search_bins  = max(max_dc_bin + 12, 20)          # +12 bin safety margin

    # ── build analytic reference chirps ───────────────────────────────────────
    up_ref_c = generate_complex_chirp(f_min, f_max, dur, fs)
    dn_ref_c = generate_complex_chirp(f_max, f_min, dur, fs)

    scorer = DechirpScorer(up_ref_c, dn_ref_c, search_bins=search_bins)
    nfft   = scorer.nfft   # confirmed power-of-two after construction

    pll = RotationPLL(
        sps, nfft, f_min, f_max, fs,
        n_rotations=n_rotations,
        lock_patience=lock_patience,
        kp=pll_kp,
    )

    agc    = AGC(target_dbfs=agc_target, release_coef=agc_release)
    syndet = SoftPreambleDetector(preamble, threshold=sync_threshold)

    rot_offsets = pll.rotation_offsets()

    print(
        f"LISTENING fs={fs} f={f_min:.0f}-{f_max:.0f}Hz BW={bw:.0f}Hz "
        f"symbol_dur={dur}s sps={sps} nfft={nfft} "
        f"search_bins=±{search_bins} (rot_residual={rot_residual}samp) "
        f"n_rotations={n_rotations} lock_patience={lock_patience} kp={pll_kp} "
        f"chunk={chunk_size}B crc={crc_bytes}B bits/frame={bits_per_frame} "
        f"sync_threshold={sync_threshold}",
        flush=True,
    )

    # ── state ─────────────────────────────────────────────────────────────────
    ring           = np.zeros(buf_size, dtype=np.float32)
    sync_found     = False
    bit_stream     = []
    frames_decoded = 0
    frames_errored = 0
    consec_errors  = 0
    decoded_frames = []
    raw_rms_vals   = []
    agc_gains      = []
    sym_count      = 0
    started_at     = time.time()
    agc_log_timer  = time.time()

    diag = {
        "sync_acquired":           False, "sync_at_symbol": None,
        "sync_score":              0.0,   "symbols_received": 0,
        "peak_rms":                0.0,   "mean_rms":  0.0,
        "silence":                 False, "agc_peak_gain_db": 0.0,
        "pll_locked_at":           None,
        "pll_best_offset_initial": None,
        "pll_best_offset_final":   None,
    }

    try:
        with sd.InputStream(samplerate=fs, channels=1, dtype="float32",
                            device=device) as stream:
            while True:
                if time.time() - started_at > timeout_sec:
                    print("TIMEOUT", flush=True)
                    break
                if stop_event is not None and stop_event.is_set():
                    break

                # ── always read exactly sps samples ───────────────────────
                # hop never changes; timing is corrected via best_offset only.
                raw, _  = stream.read(sps)
                raw     = raw.flatten()
                raw_rms_vals.append(float(np.sqrt(np.mean(raw ** 2))))

                chunk, gain, out_dbfs = agc.process(raw)
                agc_gains.append(20.0 * np.log10(gain) if gain > 1e-9 else 0.0)

                if time.time() - agc_log_timer > 10:
                    print(
                        f"AGC gain={agc_gains[-1]:.1f}dB "
                        f"level={out_dbfs:.1f}dBFS  "
                        f"pll_locked={pll.locked}  "
                        f"offset={pll.best_offset}  "
                        f"sync={sync_found}",
                        flush=True,
                    )
                    agc_log_timer = time.time()

                # ── update ring — always rolls by exactly sps ─────────────
                ring        = np.roll(ring, -sps)
                ring[-sps:] = chunk
                sym_count  += 1

                # ══════════════════════════════════════════════════════════
                # Phase 1 — pre-lock rotation scan
                # ══════════════════════════════════════════════════════════
                if not pll.locked:
                    best_score = -1.0
                    best_rot   = 0
                    for i, off in enumerate(rot_offsets):
                        win = ring[off : off + sps]
                        if len(win) < sps:
                            continue
                        _, norm, _, _, _ = scorer.score(win)
                        s = abs(float(norm))
                        if s > best_score:
                            best_score = s
                            best_rot   = i

                    if pll.pre_lock_vote(best_rot, best_score):
                        print(
                            f"PLL_LOCKED sym={sym_count} "
                            f"coarse_offset={pll.best_offset} "
                            f"search_bins=±{search_bins} "
                            f"vote_score={best_score:.3f}",
                            flush=True,
                        )
                        diag["pll_locked_at"]           = sym_count
                        diag["pll_best_offset_initial"] = pll.best_offset

                # ══════════════════════════════════════════════════════════
                # Phase 2 — post-lock: TED correction + preamble/data
                # ══════════════════════════════════════════════════════════
                else:
                    window = ring[pll.best_offset : pll.best_offset + sps]
                    bit, norm, ted_bin, up_v, dn_v = scorer.score(window)

                    # ── TED update on EVERY post-lock symbol ─────────────
                    # (preamble AND data — this was root cause 1 of the
                    #  previous CRC failures: not updating during preamble
                    #  let timing error accumulate for 8+ uncorrected symbols)
                    pll.post_lock_update(ted_bin)

                    # ── Phase 2a: preamble search ─────────────────────────
                    if not sync_found:
                        acquired, sc = syndet.push(norm)
                        if acquired:
                            print(
                                f"SYNC_ACQUIRED sym={sym_count} "
                                f"score={sc:.3f}  "
                                f"up={up_v:.1f} dn={dn_v:.1f}  "
                                f"offset={pll.best_offset} ted={ted_bin}",
                                flush=True,
                            )
                            sync_found             = True
                            diag["sync_acquired"]  = True
                            diag["sync_at_symbol"] = sym_count
                            diag["sync_score"]     = round(sc, 3)
                            bit_stream             = []
                        elif sc > 0.40:
                            print(
                                f"SYNC_CANDIDATE sym={sym_count} score={sc:.3f} "
                                f"ted={ted_bin} offset={pll.best_offset}",
                                flush=True,
                            )

                    # ── Phase 2b: data decode ─────────────────────────────
                    else:
                        bit_stream.append(bit)

                        if len(bit_stream) >= bits_per_frame:
                            frame_bits = bit_stream[:bits_per_frame]
                            bit_stream = bit_stream[bits_per_frame:]
                            raw_bytes  = bits_to_bytes(frame_bits)

                            ok, seq_num, data = check_crc(raw_bytes, chunk_size)
                            if ok:
                                try:
                                    msg = data.decode("utf-8", errors="strict")
                                    print(
                                        f"FRAME seq={seq_num} "
                                        f"offset={pll.best_offset} "
                                        f"ted={ted_bin} text={msg}",
                                        flush=True,
                                    )
                                    decoded_frames.append({"seq": seq_num, "text": msg})
                                    frames_decoded += 1
                                    consec_errors   = 0
                                except UnicodeDecodeError:
                                    msg_lossy = data.decode("utf-8", errors="replace")
                                    print(
                                        f"FRAME_ERROR seq={seq_num} reason=utf8",
                                        flush=True,
                                    )
                                    decoded_frames.append(
                                        {"seq": seq_num, "text": msg_lossy, "error": "utf8"}
                                    )
                                    frames_errored += 1
                                    consec_errors  += 1
                            else:
                                raw_hex   = raw_bytes[:6].hex() if raw_bytes else "empty"
                                seq_guess = raw_bytes[0] if raw_bytes else -1
                                print(
                                    f"FRAME_ERROR seq={seq_guess} "
                                    f"reason=crc_fail raw={raw_hex} "
                                    f"ted={ted_bin} offset={pll.best_offset}",
                                    flush=True,
                                )
                                frames_errored += 1
                                consec_errors  += 1

                            if consec_errors >= resync_after:
                                print(
                                    f"RESYNC: {consec_errors} consecutive failures "
                                    f"— restarting rotation scan…",
                                    flush=True,
                                )
                                sync_found    = False
                                bit_stream    = []
                                consec_errors = 0
                                syndet.reset()
                                pll.reset()

        diag["symbols_received"]     = sym_count
        diag["pll_best_offset_final"] = pll.best_offset
        diag["agc_peak_gain_db"]     = round(max(agc_gains), 1) if agc_gains else 0.0

    except KeyboardInterrupt:
        print("INTERRUPTED", flush=True)
        diag["symbols_received"] = sym_count
    except Exception as exc:
        import traceback
        print(f"ERROR: {exc}\n{traceback.format_exc()}", flush=True)
        result["failure_reason"] = f"stream_error: {exc}"
        result["diagnostics"]    = diag
        result_path.write_text(json.dumps(result, indent=2))
        print(json.dumps(result), flush=True)
        return result

    if raw_rms_vals:
        diag["peak_rms"] = round(float(np.max(raw_rms_vals)),  6)
        diag["mean_rms"] = round(float(np.mean(raw_rms_vals)), 6)
        diag["silence"]  = diag["peak_rms"] < silence_thr

    if diag.get("silence"):
        status, reason = "fail", f"no_audio (peak_rms={diag['peak_rms']:.6f})"
    elif not diag["sync_acquired"]:
        status, reason = "fail", f"no_sync (peak_rms={diag.get('peak_rms',0):.4f})"
    elif frames_decoded == 0 and frames_errored > 0:
        status, reason = "fail", f"crc_fail ({frames_errored} frames failed CRC)"
    elif frames_decoded == 0:
        status, reason = "fail", "partial (sync acquired but no complete frames)"
    else:
        expected = conf.get("frames")
        if expected and frames_decoded < expected:
            status, reason = "partial", f"partial ({frames_decoded}/{expected} frames)"
        else:
            status, reason = "ok", None

    result.update({
        "status":         status,
        "failure_reason": reason,
        "frames_decoded": frames_decoded,
        "frames_errored": frames_errored,
        "diagnostics":    diag,
        "frames":         decoded_frames,
    })
    if decoded_frames:
        result["decoded_text"] = "".join(
            f["text"] for f in decoded_frames if "error" not in f
        )

    print(f"DONE status={status} frames={frames_decoded}", flush=True)
    result_path.write_text(json.dumps(result, indent=2))
    print(json.dumps(result), flush=True)
    return result


if __name__ == "__main__":
    if "--print-schema" in sys.argv:
        print(json.dumps(EXAMPLE_CONFIG, indent=2))
        sys.exit(0)

    config_path = sys.argv[1] if len(sys.argv) > 1 else "css_decode_config.json"
    cfg = json.loads(Path(config_path).read_text()) if Path(config_path).exists() else {}
    result = decode(cfg)
    sys.exit(0 if result["status"] in ("ok", "partial") else 1)